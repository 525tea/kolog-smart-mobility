DB_NAME=railcargo
DB_USERNAME=railcargo
DB_PASSWORD=
DB_ROOT_PASSWORD=

JWT_SECRET=

# 브라우저가 접근하는 실제 프론트엔드 오리진. HTTPS 전환 시 https 주소를 반드시 포함한다.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://158.179.178.77,https://158.179.178.77

AI_PROVIDER=rule-based
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Document AI Form Parser (PDF·이미지 OCR)
DOCUMENT_AI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
# infra/secrets/google-document-ai.json 으로 서비스 계정 JSON을 복사한다.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-document-ai.json

# HTTPS 인증서의 대상. 도메인이 없으면 OCI 공인 IP를 사용 가능.
TLS_SERVER_NAME=158.179.178.77

# 해커톤 시연 열차를 매일 내일 일정으로 갱신. 실제 시간표 연동 후 false.
DEMO_SCHEDULE_REFRESH_ENABLED=true
DEMO_DATA_ENABLED=true

# 최초 부팅 시 운영자 계정을 생성하려면 true. 비밀번호는 12자 이상.
OPERATOR_BOOTSTRAP_ENABLED=false
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
